    { "source": "/shop", "destination": "/index.html" },
    { "source": "/products/:productSlug", "destination": "/index.html" },
    { "source": "/wardrobe", "destination": "/index.html" },
    { "source": "/collection", "destination": "/index.html" },
    { "source": "/memories", "destination": "/index.html" },
    { "source": "/about", "destination": "/index.html" },
